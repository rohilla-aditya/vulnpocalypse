# Everything here is optional. The dashboard runs with no configuration.

# Seconds between scrapes of every source (minimum 300).
REFRESH_SECONDS=3600

# Canonical public URL, used for the Twitter/OG card tags. Render sets
# RENDER_EXTERNAL_URL automatically; set this only for a custom domain.
PUBLIC_URL=

# Optional API keys. Both sources work anonymously; a key raises rate limits.
NVD_API_KEY=
GITHUB_TOKEN=

# Enables the SEC 8-K breach-disclosure source. SEC EDGAR requires clients to
# identify themselves as "Name contact-email"; the source is skipped if empty.
SEC_USER_AGENT=

# Where the last good scrape is cached (defaults to the system temp dir).
VULN_CACHE_FILE=

# Set to 0 to start without the background scraper.
VULN_AUTO_REFRESH=1
